{
  "name": "xinvxueyuan-blog",
  "version": "1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm run generate:content && pnpm run build:search && vite --host 0.0.0.0",
    "generate:content": "tsx scripts/generate-content.mts",
    "build:search": "tsx scripts/build-search-index.mts",
    "verify:static-output": "tsx scripts/verify-static-output.mts",
    "build": "pnpm run generate:content && pnpm run build:search && vite-ssg build && pnpm run verify:static-output",
    "preview": "tsx scripts/serve-static.mts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm run generate:content && vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "framework:scan": "tsx scripts/verify-vue.mts",
    "verify": "pnpm framework:scan && pnpm lint && pnpm typecheck && pnpm test && pnpm build && PLAYWRIGHT_SKIP_BUILD=1 pnpm test:e2e",
    "format": "prettier --write src tests scripts *.ts *.mjs *.mts *.json"
  },
  "dependencies": {
    "@kungal/ui-core": "2.56.2",
    "@kungal/ui-tokens": "2.56.2",
    "@kungal/ui-vue": "2.56.2",
    "@shikijs/rehype": "4.3.1",
    "@unhead/vue": "2.1.17",
    "github-slugger": "2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "0.16.47",
    "mermaid": "11.16.0",
    "photoswipe": "5.4.4",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/hast": "^3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "10.11.1",
    "fast-xml-parser": "5.10.0",
    "jsdom": "30.0.1",
    "pagefind": "1.5.2",
    "prettier": "^3.9.4",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.3.4",
    "vite-ssg": "28.3.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.13"
  }
}
